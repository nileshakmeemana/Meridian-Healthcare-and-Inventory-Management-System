# Copy to .env for local dev. On Vercel, add the same keys under
# Project → Settings → Environment Variables (no .env file is deployed).

# ── MongoDB ───────────────────────────────────────────
# Atlas (required on Vercel — allow 0.0.0.0/0 under Atlas → Network Access):
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/meridian
# Local single-node replica set (docker compose up -d):
# MONGODB_URI=mongodb://127.0.0.1:27017/meridian?replicaSet=rs0&directConnection=true

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# ── Optional ──────────────────────────────────────────
# Only for `npm run api` (standalone Express on its own port)
PORT=5000
# Extra allowed origins if the API is called from another domain (comma-separated)
# FRONTEND_URL=http://localhost:3000
# Leave unset to call the API on the same origin (/api)
# NEXT_PUBLIC_API_URL=
